# pnpm configuration
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true

# Suppress npm warnings for pnpm-specific configs
# These settings are only used by pnpm, npm will ignore them with warnings
# To silence npm warnings, we use .npmrc with npm-specific syntax

# Note: When using npx, npm may still show warnings about pnpm configs
# This is normal and can be safely ignored
