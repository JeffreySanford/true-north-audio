{
  "name": "@true-north-audio/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "// ===== DEVELOPMENT & SERVE =====": "",
    "start": "pnpm serve:all",
    "dev": "bash scripts/serve-dev.sh",
    "monitor": "bash scripts/monitor.sh",
    "serve:all": "pnpm check:ports && bash scripts/serve-all.sh",
    "serve:all:verbose": "pnpm check:ports && bash scripts/serve-all.sh --verbose",
    "serve:quick": "bash scripts/serve-all.sh",
    "serve:quick:verbose": "bash scripts/serve-all.sh --verbose",
    "serve:backend": "nx run backend:serve",
    "serve:frontend": "nx run frontend:serve",
    "serve:fastapi": "set PYTHONPATH=.:ai-music-gen&& python -m libs.musicgen.api",
    "serve:ollama": "set PYTHONPATH=.&& python -c \"from libs.musicgen.olamma_api import app; import uvicorn; uvicorn.run(app, host='0.0.0.0', port=11434)\"",
    "// ===== BUILD & COMPILE =====": "",
    "build": "nx run-many --target=build --projects=backend,frontend",
    "build:all": "pnpm build && pnpm build:python",
    "build:backend": "nx run backend:build",
    "build:frontend": "nx run frontend:build",
    "build:python": "echo 'Python dependencies installed via requirements.txt'",
    "// ===== TESTING =====": "",
    "test": "nx run-many --target=test --projects=backend,frontend",
    "test:all": "pnpm test && pnpm test:e2e && pnpm test:python",
    "test:backend": "nx run backend:test",
    "test:frontend": "nx run frontend:test",
    "test:e2e": "nx run-many --target=e2e --projects=backend-e2e,frontend-e2e",
    "test:backend-e2e": "nx run backend-e2e:e2e",
    "test:frontend-e2e": "nx run frontend-e2e:e2e",
    "test:python": "bash scripts/test-python.sh",
    "test:watch": "nx run-many --target=test --projects=backend,frontend --watch",
    "// ===== LINTING & FORMATTING =====": "",
    "lint": "nx run-many --target=lint --projects=backend,frontend,backend-e2e,frontend-e2e",
    "lint:all": "pnpm lint && pnpm lint:python",
    "lint:fix": "nx run-many --target=lint --projects=backend,frontend,backend-e2e,frontend-e2e --fix && pnpm lint:python:fix",
    "lint:python": "bash scripts/lint-python.sh",
    "lint:python:fix": "python -m autopep8 --in-place --recursive ai-music-gen/ libs/musicgen/ && python -m black ai-music-gen/ libs/musicgen/",
    "// ===== VALIDATION & HEALTH CHECKS =====": "",
    "preflight": "pnpm check:requirements && pnpm setup:mongodb && pnpm lint:all && pnpm build:all && pnpm test:all",
    "setup:mongodb": "bash scripts/setup-mongodb.sh",
    "check:requirements": "python --version && pip --version && ollama --version || echo '⚠️ Warning: Ollama not found or not running' && echo '✅ Required tools checked'",
    "check:ports": "bash scripts/check-ports.sh",
    "validate:ollama": "curl --fail http://localhost:11434/olamma/status || (echo '❌ Ollama validation failed' && exit 1)",
    "health": "pnpm check:requirements && pnpm validate:ollama",
    "// ===== CLEANUP & MAINTENANCE =====": "",
    "clean": "nx reset && rm -rf dist .nx node_modules/.cache coverage",
    "clean:all": "bash scripts/clean-rebuild.sh",
    "clean:deps": "rm -rf node_modules pnpm-lock.yaml package-lock.json && pnpm install",
    "postinstall": "pnpm setup:mongodb",
    "clear:melody": "bash scripts/clear-generated-melody.sh",
    "fix:nx": "bash scripts/fix-nx-permissions.sh",
    "kill:all": "bash scripts/kill-all.sh",
    "reset": "pnpm clean:all && code ."
  },
  "devDependencies": {
    "@angular-devkit/core": "~20.3.0",
    "@angular-devkit/schematics": "~20.3.0",
    "@angular/build": "~20.3.0",
    "@angular/cli": "~21.1.0",
    "@angular/compiler-cli": "~20.3.0",
    "@angular/language-service": "~20.3.0",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/angular": "^22.0.2",
    "@nx/devkit": "22.0.2",
    "@nx/eslint": "22.0.2",
    "@nx/eslint-plugin": "22.0.2",
    "@nx/jest": "22.0.2",
    "@nx/js": "22.0.2",
    "@nx/nest": "^22.0.2",
    "@nx/node": "22.0.2",
    "@nx/playwright": "22.0.2",
    "@nx/web": "22.0.2",
    "@nx/webpack": "22.0.2",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "~20.3.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@swc/jest": "~0.2.36",
    "@types/jest": "^29.5.12",
    "@types/node": "20.19.9",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@typescript-eslint/utils": "^8.40.0",
    "angular-eslint": "^20.3.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-preset-angular": "~14.6.1",
    "jest-util": "^29.7.0",
    "mongodb-memory-server": "^10.2.3",
    "nx": "22.0.2",
    "prettier": "^2.6.2",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@angular/cdk": "^20.2.10",
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/forms": "~20.3.0",
    "@angular/material": "^20.2.10",
    "@angular/platform-browser": "~20.3.0",
    "@angular/platform-browser-dynamic": "~20.3.0",
    "@angular/router": "~20.3.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.8",
    "@nestjs/core": "^11.0.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.0.0",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "fluent-ffmpeg": "^2.1.3",
    "mongoose": "^8.19.2",
    "reflect-metadata": "^0.1.13",
    "rxjs": "~7.8.0",
    "zone.js": "~0.15.0"
  }
}
