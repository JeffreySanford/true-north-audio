#!/bin/bash

# Get absolute workspace root
WORKSPACE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Parse arguments
VERBOSE=0
if [ "$1" = "--verbose" ] || [ "$1" = "-v" ]; then
    VERBOSE=1
fi

# Log files
BACKEND_LOG="/tmp/backend.log"
FRONTEND_LOG="/tmp/frontend.log"
FASTAPI_LOG="/tmp/fastapi.log"
OLLAMA_LOG="/tmp/ollama.log"

# Helper to normalize possible Windows paths (cygpath when available)
to_unix_path() {
    if [ -z "$1" ]; then
        echo ""
    elif command -v cygpath >/dev/null 2>&1; then
        cygpath -u "$1"
    else
        echo "$1"
    fi
}

# Detect whether mongodb-memory-server already has a cached binary
mongo_cache_ready() {
    local candidates candidate unix_candidate

    if [ -n "$MONGOMS_DOWNLOAD_DIR" ]; then
        candidates=$(to_unix_path "$MONGOMS_DOWNLOAD_DIR")
    else
        candidates="$(to_unix_path "$HOME/.cache/mongodb-binaries")
$(to_unix_path "$USERPROFILE/.cache/mongodb-binaries")
$(to_unix_path "$APPDATA/mongodb-binaries")
$(to_unix_path "$LOCALAPPDATA/mongodb-binaries")"
    fi

    # shellcheck disable=SC2086
    for candidate in $candidates; do
        unix_candidate=$(to_unix_path "$candidate")
        if [ -n "$unix_candidate" ] && [ -d "$unix_candidate" ] && ls -A "$unix_candidate" >/dev/null 2>&1; then
            return 0
        fi
    done
    return 1
}

# Verbose output function
verbose_log() {
    if [ $VERBOSE -eq 1 ]; then
        echo "  [DEBUG] $1"
    fi
}

clear
echo ""
echo "╔════════════════════════════════════════════════════════════════╗"
echo "║                                                                ║"
echo "║         🎵 TRUE NORTH AUDIO - STARTING ALL SERVICES           ║"
echo "║                                                                ║"
echo "╚════════════════════════════════════════════════════════════════╝"
echo ""

if [ $VERBOSE -eq 1 ]; then
    echo "  🔍 VERBOSE MODE ENABLED"
    echo ""
fi

START_TIME=$(date +%s)

# Helper function for status messages
print_status() {
    echo "  $1: $2"
}

# Cleanup existing processes
echo "🧹 Cleaning up existing processes..."
verbose_log "Killing node processes..."
taskkill //F //IM node.exe 2>&1 | grep -v "ERROR" >/dev/null && echo "  ✅ Node processes stopped" || echo "  ℹ️  No node processes running"
verbose_log "Killing python processes..."
taskkill //F //IM python.exe 2>&1 | grep -v "ERROR" >/dev/null && echo "  ✅ Python processes stopped" || echo "  ℹ️  No Python processes running"

# Also check and free up specific ports
verbose_log "Checking ports 3000, 4200, 8000, 11434..."
for port in 3000 4200 8000 11434; do
    PID=$(netstat -ano | grep ":$port.*LISTENING" | awk '{print $5}' | head -1)
    if [ ! -z "$PID" ]; then
        verbose_log "Killing process on port $port (PID: $PID)"
        taskkill //F //PID $PID 2>&1 | grep -v "ERROR" >/dev/null
    fi
done

# Reset Nx cache
echo ""
echo "🔄 Resetting Nx cache..."
verbose_log "Running: npx nx reset"
npx nx reset > /dev/null 2>&1
echo "  ✅ Nx cache reset complete"

# Build backend
echo ""
echo "🔨 Building backend..."
verbose_log "Running: npx nx run @true-north-audio/backend:build --skip-nx-cache"

if [ $VERBOSE -eq 1 ]; then
    npx nx run @true-north-audio/backend:build --skip-nx-cache 2>&1
else
    npx nx run @true-north-audio/backend:build --skip-nx-cache 2>&1 | grep -E "(Successfully|Error|NX|webpack)" --line-buffered || true
fi

verbose_log "Backend build completed"
echo "  ✅ Backend build complete"

# Start services
echo ""
echo "▶️  Starting services..."
echo ""
echo "  ℹ️  Backend will use in-memory MongoDB (mongodb-memory-server)"
echo ""

# Backend
print_status "Backend" "Starting on port 3000..."
verbose_log "Log file: $BACKEND_LOG"
verbose_log "Command: NODE_ENV=development node backend/dist/main.js"

nohup env NODE_ENV=development node backend/dist/main.js > $BACKEND_LOG 2>&1 </dev/null &
BACKEND_PID=$!
verbose_log "Backend PID: $BACKEND_PID"
echo "  ✅ Backend started (PID: $BACKEND_PID)"
if [ $VERBOSE -eq 0 ]; then
    echo "     Waiting for initialization..."
fi
if ! mongo_cache_ready; then
    echo "  ℹ️  First launch may download MongoDB binaries (~200MB)."
    echo "     Track progress: tail -f $BACKEND_LOG"
fi
sleep 1

# Frontend
print_status "Frontend" "Starting on port 4200..."
# Use local Nx binary to avoid npx/pnpm shims issues on Windows Git Bash; disable daemon for background
nohup env NX_DAEMON=false ./node_modules/.bin/nx serve frontend --host=0.0.0.0 --port=4200 > $FRONTEND_LOG 2>&1 </dev/null &
FRONTEND_PID=$!
echo "  ✅ Frontend started (PID: $FRONTEND_PID)"
sleep 1

# FastAPI
print_status "FastAPI" "Starting on port 8000..."
PYTHONPATH="$WORKSPACE_ROOT/ai-music-gen" nohup python -m musicgen.api > "$FASTAPI_LOG" 2>&1 </dev/null &
FASTAPI_PID=$!
echo "  ✅ FastAPI started (PID: $FASTAPI_PID)"
sleep 1

# Ollama Proxy (dev proxy, does not launch real ollama)
print_status "Ollama Proxy" "Starting on port 11434..."
# Use the libs proxy version to avoid duplicate implementations and port conflicts
PYTHONPATH="$WORKSPACE_ROOT" nohup python -c "from libs.musicgen.olamma_api import app; import uvicorn; uvicorn.run(app, host='0.0.0.0', port=11434)" > "$OLLAMA_LOG" 2>&1 </dev/null &
OLLAMA_PID=$!
echo "  ✅ Ollama Proxy started (PID: $OLLAMA_PID)"
sleep 1

# Wait for services to be ready
echo ""
echo "⏳ Waiting for services to initialize..."
if [ $VERBOSE -eq 0 ]; then
    echo "   (This may take a few seconds...)"
fi
echo ""

# Monitor backend startup
WAIT_TIME=0
MAX_WAIT=30
verbose_log "Waiting for backend to respond on port 3000 (max ${MAX_WAIT}s)..."
BACKEND_HINT_SHOWN=0
BACKEND_READY=0

while [ $WAIT_TIME -lt $MAX_WAIT ]; do
    # Check if backend is responding on port 3000
    HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:3000/api 2>/dev/null || echo "000")
    # Ready only for real HTTP codes in 2xx/3xx
    if echo "$HTTP_CODE" | grep -Eq '^(2|3)[0-9]{2}$'; then
        verbose_log "Backend is responding on port 3000 (HTTP $HTTP_CODE)"
        echo "  ✅ Backend ready after ${WAIT_TIME}s"
        BACKEND_READY=1
        break
    fi

    if [ $BACKEND_HINT_SHOWN -eq 0 ] && [ $WAIT_TIME -ge 10 ]; then
        if ! mongo_cache_ready; then
            echo ""
            echo "  ⏳ MongoDB download still in progress (mongodb-memory-server)."
            echo "  ℹ️  This can take 1-2 minutes on first run. Log: tail -f $BACKEND_LOG"
            BACKEND_HINT_SHOWN=1
        fi
    fi
    
    # Show progress dots in non-verbose mode
    if [ $VERBOSE -eq 0 ] && [ $((WAIT_TIME % 2)) -eq 0 ]; then
        echo -ne "  ."
    fi
    
    if [ $VERBOSE -eq 1 ]; then
        echo -ne "  [${WAIT_TIME}s] Checking port 3000 (HTTP: $HTTP_CODE)...\r"
    fi
    
    sleep 1
    WAIT_TIME=$((WAIT_TIME + 1))
done

if [ $VERBOSE -eq 0 ]; then
    echo "" # New line after progress dots
fi

if [ $WAIT_TIME -ge $MAX_WAIT ]; then
    echo ""
    echo "  ⚠️  Backend taking longer than expected"
    echo "  ℹ️  Check logs: tail -f $BACKEND_LOG"
    
    if [ $VERBOSE -eq 1 ]; then
        echo ""
        echo "  Last 20 lines of backend log:"
        tail -20 $BACKEND_LOG 2>/dev/null | sed 's/^/    /'
    fi
fi
echo ""

# Monitor frontend startup
WAIT_FE_TIME=0
MAX_FE_WAIT=60
verbose_log "Waiting for frontend to respond on port 4200 (max ${MAX_FE_WAIT}s)..."
FRONTEND_READY=0

while [ $WAIT_FE_TIME -lt $MAX_FE_WAIT ]; do
    HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:4200/ 2>/dev/null || echo "000")
    if echo "$HTTP_CODE" | grep -Eq '^(2|3)[0-9]{2}$'; then
        verbose_log "Frontend is responding on port 4200 (HTTP $HTTP_CODE)"
        echo "  ✅ Frontend ready after ${WAIT_FE_TIME}s"
        FRONTEND_READY=1
        break
    fi

    if [ $VERBOSE -eq 0 ] && [ $((WAIT_FE_TIME % 2)) -eq 0 ]; then
        echo -ne "  ."
    fi

    if [ $VERBOSE -eq 1 ]; then
        echo -ne "  [${WAIT_FE_TIME}s] Checking port 4200 (HTTP: $HTTP_CODE)...\r"
    fi

    sleep 1
    WAIT_FE_TIME=$((WAIT_FE_TIME + 1))
done

if [ $VERBOSE -eq 0 ]; then
    echo ""
fi

if [ $WAIT_FE_TIME -ge $MAX_FE_WAIT ]; then
    echo ""
    echo "  ⚠️  Frontend taking longer than expected"
    echo "  ℹ️  Check logs: tail -f $FRONTEND_LOG"
    if [ $VERBOSE -eq 1 ]; then
        echo ""
        echo "  Last 50 lines of frontend log:"
        tail -50 $FRONTEND_LOG 2>/dev/null | sed 's/^/    /'
    fi
fi
echo ""

# Display service banner
verbose_log "Calling service-banner.sh..."
bash scripts/service-banner.sh

END_TIME=$(date +%s)
STARTUP_TIME=$((END_TIME - START_TIME))

echo ""
echo "╔════════════════════════════════════════════════════════════════╗"
echo "║                     ��� ALL SERVICES RUNNING                    ║"
echo "╚════════════════════════════════════════════════════════════════╝"
echo ""
printf "  ⏱️  Startup time: %ds\n" "$STARTUP_TIME"
echo ""
echo "  ��� Process IDs:"
echo "     Backend:      $BACKEND_PID"
echo "     FastAPI:      $FASTAPI_PID"
echo "     Ollama Proxy: $OLLAMA_PID"
echo "     Frontend:     $FRONTEND_PID"
echo ""
echo "  📝 Logs available:"
echo "     Backend:      $BACKEND_LOG"
echo "     FastAPI:      $FASTAPI_LOG"
echo "     Ollama:       $OLLAMA_LOG"
echo "     Frontend:     $FRONTEND_LOG"
echo ""
if [ $BACKEND_READY -eq 1 ] && [ $FRONTEND_READY -eq 1 ]; then
    echo "  🌐 Endpoints:"
    echo "     Frontend:     http://localhost:4200/"
    echo "     Backend API: http://localhost:3000/api"
    echo "     FastAPI:      http://localhost:8000/docs"
    echo "     Ollama Proxy: http://localhost:11434/olamma/status"
    echo ""
    echo "  🔍 Quick checks:"
    echo "     curl --fail http://localhost:3000/api"
    echo "     curl --fail http://localhost:4200/"
    echo "     curl --fail http://localhost:11434/olamma/status"
    echo ""
else
    echo "  ⚠️  Some services have not confirmed readiness yet."
    if [ $BACKEND_READY -eq 0 ]; then
        echo "     • Backend still warming up (likely MongoDB download)."
        echo "       tail -f $BACKEND_LOG"
    fi
    if [ $FRONTEND_READY -eq 0 ]; then
        echo "     • Frontend still compiling."
        echo "       tail -f $FRONTEND_LOG"
    fi
    echo ""
fi

echo "  ⌨️  Press Ctrl+C to stop all services"
echo ""
echo "╚════════════════════════════════════════════════════════════════╝"
echo ""

# Cleanup function
cleanup() {
echo ""
echo "╔════════════════════════════════════════════════════════════════╗"
echo "║                  ��� SHUTTING DOWN SERVICES                     ║"
echo "╚════════════════════════════════════════════════════════════════╝"
echo ""

print_status "Frontend" "Stopping..."
kill $FRONTEND_PID 2>/dev/null && echo "  ✅ Frontend stopped" || echo "  ℹ️  Already stopped"

print_status "FastAPI" "Stopping..."
kill $FASTAPI_PID 2>/dev/null && echo "  ✅ FastAPI stopped" || echo "  ℹ️  Already stopped"

print_status "Ollama Proxy" "Stopping..."
kill $OLLAMA_PID 2>/dev/null && echo "  ✅ Ollama Proxy stopped" || echo "  ℹ️  Already stopped"

print_status "Backend" "Stopping..."
kill $BACKEND_PID 2>/dev/null && echo "  ✅ Backend stopped" || echo "  ℹ️  Already stopped"

echo ""
echo "  ✅ All services stopped successfully"
echo ""
exit 0
}

trap cleanup SIGINT SIGTERM

# Wait for all background processes
wait $FASTAPI_PID $OLLAMA_PID $BACKEND_PID $FRONTEND_PID
